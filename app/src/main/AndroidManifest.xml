<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Lets the app switch Do Not Disturb on for the length of a session.
        Android still requires the user to grant policy access once, by hand,
        in system settings; without that grant the feature is inert.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <uses-feature
        android:name="android.software.midi"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ALTERNATE">

        <!--
            configChanges: rotation and window resizing are handled by the app
            itself. Recreating the activity mid-game would tear down the MIDI
            session and drop a visible frame.

            screenOrientation: the app is always landscape — the waves travel
            left and right and need the wide side of the screen. Both rotations
            are allowed so the phone can be held in either hand. Android 16 and
            later ignore a fixed orientation on large screens; the HUD geometry
            is derived from the actual size rather than assumed, so it degrades
            into a narrower but working layout rather than breaking.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.ALTERNATE"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
