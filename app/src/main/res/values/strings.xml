    <!--
        Every button in this app is set in caps — START, DEMO, NEXT, DONE.
        Lint would have this one alone follow the platform "Cancel", which
        would make the one button that appears beside RESET the only one
        shouting in a different voice.
    -->
    <string name="action_cancel" tools:ignore="ButtonCase">CANCEL</string>
    <string name="action_reset">RESET</string>
    <string name="settings_unit_ms">%1$d ms</string>

    <!-- How it works: one card per step -->
    <string name="howto_next">NEXT</string>
    <string name="howto_allow">ALLOW</string>
    <string name="howto_allowed">ALLOWED</string>
    <string name="howto_done">DONE</string>

    <string name="howto_intro_title">ALTERNATE</string>
    <string name="howto_intro_body">A MIDI keypad for osu!</string>

    <string name="howto_step_1_title">PLUG IN</string>
    <string name="howto_step_1_body">Connect the phone to the PC with a data cable.\nOpen the USB notification and pick MIDI.</string>

    <string name="howto_step_2_title">TURN ON MIDI</string>
    <string name="howto_step_2_body">Open the input settings in osu!lazer.\nSwitch MIDI input on.</string>

    <string name="howto_step_3_title">BIND THE KEYS</string>
    <string name="howto_step_3_body">In the osu! key settings, select the first key and tap the pad.\nSelect the second key and tap the pad again.</string>

    <string name="howto_step_4_title">SILENCE THE PHONE</string>
    <string name="howto_step_4_body">A notification pops up and the run is over.\nLet Alternate silence them while you play.</string>

    <string name="howto_step_5_title">PLAY</string>
    <string name="howto_step_5_body">Tap anywhere — the whole screen is the button.\nPress Back twice to leave.</string>

